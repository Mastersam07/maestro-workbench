{
  "name": "maestro-workbench",
  "displayName": "Maestro Workbench",
  "description": "A VS Code extension for Maestro YAML validation, IntelliSense, and testing.",
  "publisher": "Mastersam",
  "license": "MIT",
  "version": "0.3.0",
  "icon": "assets/icon.png",
  "author": {
    "email": "abadasamuelosp@gmail.com",
    "name": "Samuel Abada",
    "url": "https://github.com/mastersam07"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mastersam07/maestro-workbench"
  },
  "bugs": {
    "url": "https://github.com/Mastersam07/maestro-workbench/issues",
    "email": "abadasamuelosp@gmail.com"
  },
  "engines": {
    "vscode": "^1.61.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Extension Packs",
    "Debuggers",
    "Linters",
    "Testing"
  ],
  "keywords": [
    "maestro",
    "tests",
    "ui testing",
    "ui test",
    "maestro studio",
    "yaml"
  ],
  "homepage": "https://github.com/Mastersam07/maestro-workbench",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "yaml.schemas": {
      "./schema/maestro.schema.v0.json": [
        "*.yaml",
        "*.yml"
      ]
    },
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "aliases": [
          "YAML",
          "yaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maestroWorkbench",
          "title": "Maestro Workbench",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "maestroWorkbench": [
        {
          "id": "maestroBenchTreeView",
          "name": "Maestro Workbench"
        }
      ]
    },
    "commands": [
      {
        "command": "maestroWorkbench.openMaestroStudio",
        "title": "Open Maestro Studio",
        "icon": "$(debug-console)"
      },
      {
        "command": "maestroWorkbench.refreshTree",
        "title": "Refresh Maestro Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "maestroWorkbench.runTest",
        "title": "Run Test for Flow",
        "icon": "$(debug-start)"
      },
      {
        "command": "maestroWorkbench.runFolderTests",
        "title": "Run All Flows in Folder",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "maestroWorkbench.openMaestroStudio",
          "when": "view == maestroBenchTreeView",
          "group": "navigation"
        },
        {
          "command": "maestroWorkbench.refreshTree",
          "when": "view == maestroBenchTreeView",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/snippets.v0.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Maestro Workbench Settings",
      "properties": {
        "maestroWorkbench.filePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "maestro/**/*.yaml",
            "maestro/**/*.yml",
            "**/.maestro/**/*.yaml",
            "**/.maestro/**/*.yml"
          ],
          "description": "Glob patterns to locate Maestro files. You can customize these to include or exclude specific directories."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/vscode": "^1.61.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
