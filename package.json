{
  "name": "maestro-workbench",
  "displayName": "Maestro Workbench",
  "description": "A VS Code extension for Maestro YAML validation, IntelliSense, and testing.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:maestro",
    "workspaceContains:.maestro"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "yaml.schemas": {
      "./schema/maestro.schema.v0.json": [
        "*.yaml",
        "*.yml"
      ]
    },
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "aliases": [
          "YAML",
          "yaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maestroWorkbench",
          "title": "Maestro Workbench",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "maestroWorkbench": [
        {
          "id": "maestroBenchTreeView",
          "name": "Maestro Workbench"
        }
      ]
    },
    "commands": [
      {
        "command": "maestroWorkbench.openMaestroStudio",
        "title": "Open Maestro Studio",
        "icon": "$(debug-console)"
      },
      {
        "command": "maestroWorkbench.refreshTree",
        "title": "Refresh Maestro Tree",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "maestroWorkbench.openMaestroStudio",
          "when": "view == maestroBenchTreeView",
          "group": "navigation"
        },
        {
          "command": "maestroWorkbench.refreshTree",
          "when": "view == maestroBenchTreeView",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/snippets.v0.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Maestro Workbench Settings",
      "properties": {
        "maestroWorkbench.filePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "maestro/**/*.{yaml,yml}",
            "**/.maestro/**/*.{yaml,yml}"
          ],
          "description": "Glob patterns to locate Maestro files. You can customize these to include or exclude specific directories."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}